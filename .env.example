# Copy these settings into your shell or your Streamlit host's secret/environment manager.
SPORTS_DATABASE_PATH=C:\path\to\persistent\storage\sports_event.db
SPORTS_ADMIN_EMAIL=admin@example.edu
SPORTS_ADMIN_PASSWORD=replace-with-a-long-unique-password
SPORTS_ADMIN_NAME=Sports Administrator
SPORTS_STAFF_INVITE_CODE=replace-with-a-long-random-invite-code
SPORTS_ORGANIZER_ACCESS_CODE=replace-with-a-separate-long-random-access-code
# Set the externally reachable Streamlit URL so registration/certificate QR codes link back.
APP_BASE_URL=https://your-streamlit-host.example
